<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculator.CalcPage"
             Title="CalcPage">
    <VerticalStackLayout Spacing="10" WidthRequest="600">
        <Label x:Name="lblResult">
            
        </Label>
        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*" HeightRequest="600" ColumnSpacing="10" RowSpacing="10">
            <Button Text="1" Grid.Row="0" Grid.Column="0" Clicked="OnButtonClicked"/>
            <Button Text="2" Grid.Row="0" Grid.Column="1" Clicked="OnButtonClicked"/>
            <Button Text="3" Grid.Row="0" Grid.Column="2" Clicked="OnButtonClicked"/>
            <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="OnButtonClicked"/>
            <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="OnButtonClicked"/>
            <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="OnButtonClicked"/>
            <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="OnButtonClicked"/>
            <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="OnButtonClicked"/>
            <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="OnButtonClicked"/>
            <Button Text="0" Grid.Row="3" Grid.Column="0" Clicked="OnButtonClicked"/>
            <Button Text="+" Grid.Row="0" Grid.Column="3" Clicked="OnButtonClicked"/>
            <Button Text="-" Grid.Row="1" Grid.Column="3" Clicked="OnButtonClicked"/>
            <Button Text="*" Grid.Row="2" Grid.Column="3" Clicked="OnButtonClicked"/>
            <Button Text="/" Grid.Row="3" Grid.Column="3" Clicked="OnButtonClicked"/>
            <Button Text="C" Grid.Row="3" Grid.Column="1" Clicked="OnClearClicked"/>
            <Button Text="=" Grid.Row="3" Grid.Column="2" Clicked="OnEqualsClicked"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>